# ==============================================================================
# PUERTOS DEL HOST (Mapeo hacia tu máquina local)
# ==============================================================================
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555
JAEGER_UI_PORT=16686
OTEL_PORT=4318

# Flower (colas y tareas de Celery). Usuario:clave de su interfaz. Con docker compose el valor por
# defecto es admin:admin (solo escucha en 127.0.0.1); con `make flower`, si no lo defines, se genera
# una clave aleatoria en cada arranque. Cambiala fuera de tu maquina local.
# FLOWER_BASIC_AUTH=admin:cambia-esto

# ==============================================================================
# ENTORNO
# ==============================================================================
ENVIRONMENT=development

# ==============================================================================
# CONFIGURACIÓN LLM AGNOSTICA (mock por defecto para evaluación offline)
# Proveedores soportados: 'mock', 'gemini', 'openai'
# ==============================================================================
LLM_PROVIDER=mock
# Requerido si LLM_PROVIDER no es 'mock':
LLM_API_KEY=
# Ejemplos: 'gemini-1.5-flash', 'gpt-4o-mini', 'llama3'
LLM_MODEL=gemini-1.5-flash
# URL base opcional para el LLM (ej. para OpenAI compatible, Ollama, vLLM, OpenRouter, Azure):
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# ==============================================================================
# CONFIGURACIÓN DE EMBEDDINGS (Agnóstica y URL independiente)
# Proveedores soportados: 'mock', 'gemini', 'openai'
# ==============================================================================
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
# Ejemplos: 'gemini/text-embedding-004', 'text-embedding-3-small', 'ollama/nomic-embed-text'
EMBEDDING_MODEL=gemini/text-embedding-004
# URL base separada para microservicio de embeddings (ej. TEI, Infinity, Ollama dedicado):
EMBEDDING_BASE_URL=
# Dimensión del vector para pgvector (Vector(768) en PostgreSQL):
EMBEDDING_DIMENSIONS=768

# ==============================================================================
# BASE DE DATOS Y VECTOR STORE (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=maritime_rag
# Para Docker compose usa el host 'db'; para ejecución local directa usa 'localhost':
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/maritime_rag

# ==============================================================================
# BROKER Y STORAGE (Celery + Redis + Almacenamiento local)
# ==============================================================================
# Para Docker compose usa 'redis'; para ejecución local directa usa 'localhost':
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Ruta de almacenamiento de archivos PDF (en contenedor Docker: /app/storage/contracts):
STORAGE_PATH=/app/storage/contracts
MAX_FILE_SIZE_BYTES=26214400
# Un documento en 'processing' más de estos segundos se marca 'failed' (reaper de Celery Beat):
PROCESSING_TIMEOUT_SECONDS=900
# Redis reentrega una tarea sin confirmar tras estos segundos (debe superar la duración de la tarea):
TASK_VISIBILITY_TIMEOUT_SECONDS=600

# ==============================================================================
# EVENTOS DE DOMINIO ENTRE PROCESOS (Redis Streams)
# El worker publica 'document.processing_started|ready|failed' y la API los envía al
# navegador por SSE (GET /api/v1/documents/events). 'memory' los deja dentro del proceso
# (sin SSE: la interfaz usa solo polling).
# ==============================================================================
EVENT_BUS_BACKEND=redis
# Base de datos distinta de las de Celery (0 broker, 1 resultados). Local directo: usa 'localhost'.
EVENT_REDIS_URL=redis://redis:6379/2
EVENT_STREAM_KEY=maritime:events
EVENT_STREAM_MAXLEN=10000

# ==============================================================================
# PARÁMETROS DE INDEXACIÓN Y CONSULTA RAG
# ==============================================================================
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=80
RAG_SIMILARITY_THRESHOLD=0.25
RAG_TOP_K=5

# ==============================================================================
# CORS Y FRONTEND (Bun + Vite)
# ==============================================================================
CORS_ORIGINS=*
VITE_API_URL=/api/v1
BACKEND_PROXY_TARGET=http://api:8000
VITE_POLL_INTERVAL_MS=2000
VITE_API_TIMEOUT_MS=30000
VITE_MAX_FILE_SIZE_MB=25

# ==============================================================================
# OBSERVABILIDAD OPENTELEMETRY (Jaeger)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_SERVICE_NAME=maritime-rag
